# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin
ADMIN_PASSWORD=your-admin-password
ADMIN_SESSION_SECRET=generate-a-random-64-char-hex-string

# Crypto Payouts (Base chain USDC)
# WARNING: This key controls real funds. Never commit it. Use a secret manager in production.
TREASURY_PRIVATE_KEY=0x...
BASE_RPC_URL=https://mainnet.base.org
CRON_SECRET=random-secret

# Maximum single payout amount in USD (safety limit, default: 10000)
MAX_SINGLE_PAYOUT=10000

# WalletConnect (admin wallet-connect payouts)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# Email notifications (optional — falls back to in-app notifications if not set)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# EMAIL_FROM=Depay <noreply@depay.app>

# Admin alert email (receives payout failure alerts)
# ADMIN_ALERT_EMAIL=admin@depay.app

# Error monitoring (optional — get DSN from https://sentry.io)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
